{
  "name": "pigeon-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:e2e": "tsx --env-file=.env.e2e src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "firebase emulators:exec --project demo-pigeon-test --only firestore \"vitest run --config vitest.db.config.ts\"",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node ../scripts/seed-local.mjs"
  },
  "volta": {
    "node": "24.22.3"
  },
  "dependencies": {
    "@assistant-ui/generative-ui": "0.0.11",
    "@assistant-ui/react": "0.15.36",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "firebase-admin": "14.5.1",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "firebase-tools": "15.36.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
